# Copy this file to .env and fill in real values for local development.
# (dotenv-rails, already in the Gemfile, loads .env automatically.)

RUNOWN_DATABASE_HOST=localhost
RUNOWN_DATABASE_USERNAME=postgres
RUNOWN_DATABASE_PASSWORD=password

# Comma-separated list of origins allowed to call the API in production,
# e.g. https://runown.app,https://www.runown.app
RUNOWN_ALLOWED_ORIGINS=

# Comma-separated list of hostnames this API is allowed to respond as, e.g.
# runown-backend.onrender.com,api.runown.app. Leave blank in development.
RUNOWN_ALLOWED_HOSTS=

# Required in production - generate with:
#   ruby -rsecurerandom -e "puts SecureRandom.hex(64)"
# Never commit the real value; set it as a secret on whatever platform
# runs this app. Not needed for local development (Rails generates a
# throwaway one automatically outside of production).
SECRET_KEY_BASE=
